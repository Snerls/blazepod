{
  "name": "blazepod-hack",
  "version": "1.0.0",
  "description": "A Python desktop app that drives BlazePod reaction pods over BLE without the official app or subscription. Reaction-time data stays local — no cloud, no account.",
  "main": "index.js",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run build && npx cap sync ios && npx cap open ios",
    "test:protocol": "node web/js/protocol.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snerls/blazepod.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Snerls/blazepod/issues"
  },
  "homepage": "https://github.com/Snerls/blazepod#readme",
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "webbluetooth": "^3.7.0"
  },
  "devDependencies": {
    "vite": "^8.0.10"
  }
}
